<service>
  <id>NotaSyncGCONT</id>
  <name>NotaSync GCONT</name>
  <description>Servico interno NotaSync GCONT para busca e consulta de NFS-e.</description>
  <executable>C:\Windows\System32\cmd.exe</executable>
  <arguments>/d /c deploy\windows\start-notasync.cmd</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <env name="NODE_ENV" value="production" />
  <env name="PORT" value="3000" />
  <env name="STORAGE_ROOT_PATH" value="%BASE%\storage" />
  <logpath>%BASE%\logs</logpath>
  <log mode="roll" />
  <onfailure action="restart" delay="10 sec" />
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>20 sec</stoptimeout>
</service>

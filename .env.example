NODE_ENV=production
PORT=3000
REQUEST_BODY_LIMIT=10mb

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nfse_collector?schema=public
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nfse-storage
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

CERT_MASTER_KEY=CHANGE_ME_WITH_32_PLUS_CHAR_RANDOM_SECRET
STORAGE_ROOT_PATH=storage

NFSE_ADN_CLIENT_MODE=real
NFSE_API_BASE_URL_PRODUCAO=https://adn.nfse.gov.br
NFSE_API_BASE_URL_RESTRITA=https://adn.producaorestrita.nfse.gov.br
NFSE_ADN_PATH_PREFIX=contribuintes
NFSE_ADN_TIMEOUT_MS=30000
NFSE_ADN_REJECT_UNAUTHORIZED=true
NFE_DISTRIBUICAO_CLIENT_MODE=mock
NFE_DISTRIBUICAO_URL_PRODUCAO=https://www1.nfe.fazenda.gov.br/NFeDistribuicaoDFe/NFeDistribuicaoDFe.asmx
NFE_DISTRIBUICAO_URL_HOMOLOGACAO=https://hom1.nfe.fazenda.gov.br/NFeDistribuicaoDFe/NFeDistribuicaoDFe.asmx
NFE_DISTRIBUICAO_CUF_AUTOR=
NFE_DISTRIBUICAO_TIMEOUT_MS=30000
NFE_DISTRIBUICAO_REJECT_UNAUTHORIZED=true
CTE_CONSULTA_CLIENT_MODE=mock
CTE_CONSULTA_URL_PRODUCAO=
CTE_CONSULTA_URL_HOMOLOGACAO=
CTE_CONSULTA_LAYOUT_VERSION=4.00
CTE_CONSULTA_TIMEOUT_MS=30000
CTE_CONSULTA_REJECT_UNAUTHORIZED=true
NFE_SYNC_SOURCE_MODE=distribuicao
DOMINIO_NFE_SOURCE_MODE=mock
DOMINIO_ODBC_CONNECTION_STRING=
DOMINIO_PYTHON_BIN=python
NFE_DOMINIO_IMPORT_LIMIT_PER_RUN=500
ENABLE_SWAGGER=false

SYNC_AUTO_RUN_ENABLED=true
SYNC_AUTO_RUN_INTERVAL_MS=30000
SYNC_AUTO_RUN_STARTUP_DELAY_MS=3000
SYNC_API_RETRY_DELAY_MS=120000
SYNC_API_RETRY_JITTER_MS=60000
SYNC_DAILY_INTERVAL_MS=86400000
SYNC_DAILY_MAX_NSU_PER_RUN=10
SYNC_DAILY_STOP_ON_FIRST_DOCUMENT=false
SYNC_DAILY_SUCCESS_COOLDOWN_MS=120000
SYNC_ADN_REQUEST_INTERVAL_MS=5000
SYNC_PAST_NSU_RETRY_COUNT=2
SYNC_PAST_NSU_RETRY_DELAY_MS=5000
SYNC_ADN_RATE_LIMIT_COOLDOWN_MS=300000
SYNC_NIGHTLY_SWEEP_ENABLED=true
SYNC_NIGHTLY_SWEEP_SLOTS=18:00,20:00,22:00,00:00,02:00,04:00,06:00
SYNC_NIGHTLY_SWEEP_HOUR=2
SYNC_NIGHTLY_SWEEP_MINUTE=0
SYNC_NIGHTLY_SWEEP_TIMEZONE_OFFSET_MINUTES=-180
SYNC_NIGHTLY_SWEEP_CHECK_INTERVAL_MS=60000

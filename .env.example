NODE_ENV=development
PORT=3000
REQUEST_BODY_LIMIT=10mb

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nfse_collector?schema=public
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nfse-storage
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

CERT_MASTER_KEY=change-me-with-32-byte-secret
JWT_SECRET=change-me
STORAGE_ROOT_PATH=storage

NFSE_ADN_CLIENT_MODE=mock
NFSE_API_BASE_URL_PRODUCAO=https://adn.nfse.gov.br
NFSE_API_BASE_URL_RESTRITA=https://adn.producaorestrita.nfse.gov.br
NFSE_ADN_PATH_PREFIX=contribuintes
NFSE_ADN_TIMEOUT_MS=30000
NFSE_ADN_REJECT_UNAUTHORIZED=true

SYNC_AUTO_RUN_ENABLED=true
SYNC_AUTO_RUN_INTERVAL_MS=30000
SYNC_AUTO_RUN_STARTUP_DELAY_MS=3000
SYNC_API_RETRY_DELAY_MS=60000

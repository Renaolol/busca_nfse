NODE_ENV=development
PORT=3000
REQUEST_BODY_LIMIT=10mb

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nfse_collector?schema=public
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nfse-storage
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

CERT_MASTER_KEY=CHANGE_ME_WITH_32_PLUS_CHAR_RANDOM_SECRET
STORAGE_ROOT_PATH=storage

NFSE_ADN_CLIENT_MODE=mock
NFSE_API_BASE_URL_PRODUCAO=https://adn.nfse.gov.br
NFSE_API_BASE_URL_RESTRITA=https://adn.producaorestrita.nfse.gov.br
NFSE_ADN_PATH_PREFIX=contribuintes
NFSE_ADN_TIMEOUT_MS=30000
NFSE_ADN_REJECT_UNAUTHORIZED=true

SYNC_AUTO_RUN_ENABLED=true
SYNC_AUTO_RUN_INTERVAL_MS=30000
SYNC_AUTO_RUN_STARTUP_DELAY_MS=3000
SYNC_API_RETRY_DELAY_MS=60000
SYNC_API_RETRY_JITTER_MS=30000
SYNC_DAILY_INTERVAL_MS=86400000
SYNC_DAILY_MAX_NSU_PER_RUN=10
SYNC_DAILY_STOP_ON_FIRST_DOCUMENT=true
SYNC_DAILY_SUCCESS_COOLDOWN_MS=60000
SYNC_ADN_REQUEST_INTERVAL_MS=1200
SYNC_ADN_RATE_LIMIT_COOLDOWN_MS=180000
SYNC_NIGHTLY_SWEEP_ENABLED=true
SYNC_NIGHTLY_SWEEP_HOUR=2
SYNC_NIGHTLY_SWEEP_MINUTE=0
SYNC_NIGHTLY_SWEEP_TIMEZONE_OFFSET_MINUTES=-180
SYNC_NIGHTLY_SWEEP_CHECK_INTERVAL_MS=60000

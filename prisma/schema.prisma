generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Ambiente {
  producao
  producao_restrita
}

enum SyncMode {
  historico_desde_nsu_1
  historico_a_partir_de_nsu
  somente_novas
}

enum SyncStatus {
  ativo
  pausado
  erro_certificado
  erro_autorizacao
  erro_api
  finalizado_historico
}

enum DocumentoOrigem {
  adn_nsu
  importacao_xml
  consulta_chave
  consulta_dps
}

enum NfseNumeracaoExcecaoTipo {
  inutilizada
  nao_existe
}

enum NfeAmbiente {
  producao
  homologacao
}

enum NfeSyncStatus {
  ativo
  pausado
  processando
  erro_certificado
  erro_autorizacao
  erro_api
}

enum NfeDocumentoOrigem {
  distribuicao_nsu
  importacao_xml
  sef_sc_nfce
  sef_sc_nfe
}

enum NfceScRecoveryStatus {
  processando
  concluido
  pausado
  erro
}

enum NfeTipoRelacao {
  emitida
  recebida
}

enum NfseDocumentoVinculoPapel {
  emissao
  tomada
}

enum UsuarioRole {
  admin
  comum
  cliente
}

enum EventoAcessoTipo {
  login_sucesso
  login_falha
  logout
  token_renovado
  sessao_expirada
  acesso_negado
}

enum DocumentoConferenciaTipo {
  nfse
  nfe
  cte
}

model Cliente {
  id                   String   @id @default(uuid()) @db.Uuid
  razaoSocial          String   @map("razao_social") @db.VarChar(255)
  nomeFantasia         String?  @map("nome_fantasia") @db.VarChar(255)
  cnpj                 String   @unique @db.VarChar(14)
  responsavelInterno   String?  @map("responsavel_interno") @db.VarChar(255)
  emailResponsavel     String?  @map("email_responsavel") @db.VarChar(255)
  telefone             String?  @db.VarChar(30)
  ativo                Boolean  @default(true)
  nfeHabilitado        Boolean  @default(true) @map("nfe_habilitado")
  codigoEmpresaDominio Int?     @map("codigo_empresa_dominio")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  estabelecimentos          ClienteEstabelecimento[]
  certificados              Certificado[]
  syncControles             NfseSyncControle[]
  documentos                NfseDocumento[]
  documentoVinculos         NfseDocumentoVinculo[]
  numeracaoExcecoes         NfseNumeracaoExcecao[]
  contasContabilConfig      NfseContaContabilConfig[]
  nfeSyncControles          NfeSyncControle[]
  nfceScSyncControles       NfceScSyncControle[]
  nfeScSyncControles        NfeScSyncControle[]
  nfeDocumentos             NfeDocumento[]
  syncLogs                  NfseSyncLog[]
  auditorias                AuditoriaUsuario[]
  alertResolutions          AlertResolution[]
  compareSpedHistoricos     CompareSpedHistorico[]
  usuarios                  Usuario[]
  eventosAcesso             EventoAcesso[]
  conferenciasDocumentos    DocumentoConferencia[]
  nfeManifestacoes          NfeManifestacao[]
  nfeAutomacaoConfiguracoes NfeAutomacaoConfiguracao[]
  nfeAutomacaoAuditorias    NfeAutomacaoAuditoria[]
  nfeXmlRecuperacoes        NfeXmlRecuperacao[]

  @@map("clientes")
}

model ClienteEstabelecimento {
  id                  String   @id @default(uuid()) @db.Uuid
  clienteId           String   @map("cliente_id") @db.Uuid
  cnpj                String   @db.VarChar(14)
  razaoSocial         String?  @map("razao_social") @db.VarChar(255)
  inscricaoMunicipal  String?  @map("inscricao_municipal") @db.VarChar(50)
  logradouro          String?  @db.VarChar(255)
  bairro              String?  @db.VarChar(120)
  cep                 String?  @db.VarChar(20)
  uf                  String?  @db.VarChar(2)
  municipioCodigoIbge String?  @map("municipio_codigo_ibge") @db.VarChar(7)
  municipioNome       String?  @map("municipio_nome") @db.VarChar(120)
  ativo               Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  cliente                   Cliente                    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  certificados              Certificado[]
  syncControles             NfseSyncControle[]
  documentos                NfseDocumento[]
  documentoVinculos         NfseDocumentoVinculo[]
  nfeSyncControles          NfeSyncControle[]
  nfceScSyncControles       NfceScSyncControle[]
  nfeScSyncControles        NfeScSyncControle[]
  nfeDocumentos             NfeDocumento[]
  nfeManifestacoes          NfeManifestacao[]
  nfeAutomacaoConfiguracoes NfeAutomacaoConfiguracao[]
  nfeAutomacaoAuditorias    NfeAutomacaoAuditoria[]
  nfeXmlRecuperacoes        NfeXmlRecuperacao[]

  @@unique([clienteId, cnpj], map: "cliente_estabelecimentos_cliente_id_cnpj_key")
  @@map("cliente_estabelecimentos")
}

model Certificado {
  id                          String    @id @default(uuid()) @db.Uuid
  clienteId                   String?   @map("cliente_id") @db.Uuid
  estabelecimentoId           String?   @map("estabelecimento_id") @db.Uuid
  nome                        String    @db.VarChar(255)
  cnpjTitular                 String    @map("cnpj_titular") @db.VarChar(14)
  tipo                        String    @default("A1") @db.VarChar(20)
  arquivoCriptografadoPath    String    @map("arquivo_criptografado_path") @db.Text
  senhaCriptografada          String    @map("senha_criptografada") @db.Text
  validadeInicio              DateTime? @map("validade_inicio")
  validadeFim                 DateTime? @map("validade_fim")
  thumbprint                  String?   @db.VarChar(255)
  serialNumber                String?   @map("serial_number") @db.VarChar(255)
  emissor                     String?   @db.Text
  subject                     String?   @db.Text
  anotacoes                   String?   @db.Text
  ativo                       Boolean   @default(true)
  substituidoPorCertificadoId String?   @map("substituido_por_certificado_id") @db.Uuid
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  cliente             Cliente?                @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  estabelecimento     ClienteEstabelecimento? @relation(fields: [estabelecimentoId], references: [id], onDelete: SetNull)
  syncLogs            NfseSyncLog[]
  nfceScSyncControles NfceScSyncControle[]
  nfeScSyncControles  NfeScSyncControle[]
  nfeManifestacoes    NfeManifestacao[]

  @@map("certificados")
}

model NfseSyncControle {
  id                      String      @id @default(uuid()) @db.Uuid
  clienteId               String      @map("cliente_id") @db.Uuid
  estabelecimentoId       String      @map("estabelecimento_id") @db.Uuid
  cnpjConsulta            String      @map("cnpj_consulta") @db.VarChar(14)
  ambiente                Ambiente
  ultimoNsuConsultado     BigInt      @default(0) @map("ultimo_nsu_consultado")
  ultimoNsuComDocumento   BigInt      @default(0) @map("ultimo_nsu_com_documento")
  nsuInicial              BigInt      @default(1) @map("nsu_inicial")
  modoSync                SyncMode?   @map("modo_sync")
  status                  SyncStatus? @default(ativo)
  ultimaExecucao          DateTime?   @map("ultima_execucao")
  proximaExecucao         DateTime?   @map("proxima_execucao")
  ultimaMensagem          String?     @map("ultima_mensagem") @db.Text
  totalDocumentosBaixados Int         @default(0) @map("total_documentos_baixados")
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")

  cliente         Cliente                @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  estabelecimento ClienteEstabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  syncLogs        NfseSyncLog[]

  @@unique([clienteId, cnpjConsulta, ambiente], map: "nfse_sync_controle_cliente_id_cnpj_consulta_ambiente_key")
  @@map("nfse_sync_controle")
}

model NfseDocumento {
  id                          String           @id @default(uuid()) @db.Uuid
  clienteId                   String           @map("cliente_id") @db.Uuid
  estabelecimentoId           String           @map("estabelecimento_id") @db.Uuid
  ambiente                    Ambiente
  nsu                         BigInt?
  chaveAcesso                 String           @map("chave_acesso") @db.VarChar(100)
  numeroNfse                  String?          @map("numero_nfse") @db.VarChar(50)
  serie                       String?          @db.VarChar(50)
  dataEmissao                 DateTime?        @map("data_emissao")
  competencia                 DateTime?        @db.Date
  dataCancelamento            DateTime?        @map("data_cancelamento")
  status                      String?          @db.VarChar(50)
  cnpjPrestador               String?          @map("cnpj_prestador") @db.VarChar(14)
  razaoSocialPrestador        String?          @map("razao_social_prestador") @db.VarChar(255)
  cnpjTomador                 String?          @map("cnpj_tomador") @db.VarChar(14)
  razaoSocialTomador          String?          @map("razao_social_tomador") @db.VarChar(255)
  municipioPrestacaoCodigo    String?          @map("municipio_prestacao_codigo") @db.VarChar(7)
  municipioPrestacaoNome      String?          @map("municipio_prestacao_nome") @db.VarChar(120)
  valorServico                Decimal?         @map("valor_servico") @db.Decimal(15, 2)
  valorServicoManual          Decimal?         @map("valor_servico_manual") @db.Decimal(15, 2)
  valorDeducoes               Decimal?         @map("valor_deducoes") @db.Decimal(15, 2)
  valorDescontoIncondicionado Decimal?         @map("valor_desconto_incondicionado") @db.Decimal(15, 2)
  valorDescontoCondicionado   Decimal?         @map("valor_desconto_condicionado") @db.Decimal(15, 2)
  valorIss                    Decimal?         @map("valor_iss") @db.Decimal(15, 2)
  aliquotaIss                 Decimal?         @map("aliquota_iss") @db.Decimal(8, 4)
  codigoServicoNacional       String?          @map("codigo_servico_nacional") @db.VarChar(50)
  itemListaServico            String?          @map("item_lista_servico") @db.VarChar(50)
  descricaoServico            String?          @map("descricao_servico") @db.Text
  xmlPath                     String?          @map("xml_path") @db.Text
  danfsePath                  String?          @map("danfse_path") @db.Text
  hashXml                     String?          @map("hash_xml") @db.VarChar(128)
  chaveSubstituida            String?          @map("chave_substituida") @db.VarChar(100)
  ignorarNumeracaoValidacao   Boolean          @default(false) @map("ignorar_numeracao_validacao")
  ignorarNumeracaoObservacao  String?          @map("ignorar_numeracao_observacao") @db.Text
  origem                      DocumentoOrigem?
  createdAt                   DateTime         @default(now()) @map("created_at")
  updatedAt                   DateTime         @updatedAt @map("updated_at")

  cliente         Cliente                @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  estabelecimento ClienteEstabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  eventos         NfseEvento[]
  vinculos        NfseDocumentoVinculo[]

  @@unique([ambiente, chaveAcesso], map: "nfse_documentos_ambiente_chave_acesso_key")
  @@unique([clienteId, ambiente, nsu], map: "nfse_documentos_cliente_id_ambiente_nsu_key")
  @@index([ambiente, chaveSubstituida], map: "nfse_documentos_ambiente_chave_substituida_idx")
  @@map("nfse_documentos")
}

model NfseDocumentoVinculo {
  id                String                    @id @default(uuid()) @db.Uuid
  nfseDocumentoId   String                    @map("nfse_documento_id") @db.Uuid
  clienteId         String                    @map("cliente_id") @db.Uuid
  estabelecimentoId String?                   @map("estabelecimento_id") @db.Uuid
  papel             NfseDocumentoVinculoPapel
  ambiente          Ambiente
  nsu               BigInt?
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  documento       NfseDocumento           @relation(fields: [nfseDocumentoId], references: [id], onDelete: Cascade)
  cliente         Cliente                 @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  estabelecimento ClienteEstabelecimento? @relation(fields: [estabelecimentoId], references: [id], onDelete: SetNull)

  @@unique([nfseDocumentoId, papel], map: "nfse_documento_vinculos_documento_papel_key")
  @@unique([clienteId, ambiente, nsu], map: "nfse_documento_vinculos_cliente_ambiente_nsu_key")
  @@index([clienteId], map: "nfse_documento_vinculos_cliente_id_idx")
  @@map("nfse_documento_vinculos")
}

model NfseEvento {
  id              String    @id @default(uuid()) @db.Uuid
  nfseDocumentoId String    @map("nfse_documento_id") @db.Uuid
  chaveAcesso     String    @map("chave_acesso") @db.VarChar(100)
  tipoEvento      String?   @map("tipo_evento") @db.VarChar(100)
  dataEvento      DateTime? @map("data_evento")
  descricao       String?   @db.Text
  xmlPath         String?   @map("xml_path") @db.Text
  hashXml         String?   @map("hash_xml") @db.VarChar(128)
  createdAt       DateTime  @default(now()) @map("created_at")

  nfseDocumento NfseDocumento @relation(fields: [nfseDocumentoId], references: [id], onDelete: Cascade)

  @@unique([chaveAcesso, tipoEvento, dataEvento, hashXml], map: "nfse_eventos_chave_tipo_data_hash_key")
  @@map("nfse_eventos")
}

model NfseNumeracaoExcecao {
  id           String                   @id @default(uuid()) @db.Uuid
  clienteId    String                   @map("cliente_id") @db.Uuid
  cnpjConsulta String                   @map("cnpj_consulta") @db.VarChar(14)
  ambiente     Ambiente
  numeroNfse   Int                      @map("numero_nfse")
  tipo         NfseNumeracaoExcecaoTipo
  observacao   String?                  @db.Text
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, cnpjConsulta, ambiente, numeroNfse], map: "nfse_numeracao_excecoes_cliente_cnpj_ambiente_numero_key")
  @@index([clienteId, cnpjConsulta, ambiente], map: "nfse_numeracao_excecoes_cliente_cnpj_ambiente_idx")
  @@map("nfse_numeracao_excecoes")
}

model NfseContaContabilConfig {
  id            String   @id @default(uuid()) @db.Uuid
  clienteId     String   @map("cliente_id") @db.Uuid
  codigoServico String   @map("codigo_servico") @db.VarChar(50)
  contaContabil String   @map("conta_contabil") @db.VarChar(50)
  produto       String?  @db.VarChar(50)
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, codigoServico], map: "nfse_conta_contabil_config_cliente_id_codigo_servico_key")
  @@map("nfse_conta_contabil_config")
}

model NfseSyncLog {
  id              String    @id @default(uuid()) @db.Uuid
  clienteId       String    @map("cliente_id") @db.Uuid
  controleSyncId  String?   @map("controle_sync_id") @db.Uuid
  certificadoId   String?   @map("certificado_id") @db.Uuid
  ambiente        Ambiente?
  nsuConsultado   BigInt?   @map("nsu_consultado")
  status          String?   @db.VarChar(50)
  mensagem        String?   @db.Text
  requestId       String?   @map("request_id") @db.VarChar(255)
  httpStatus      Int?      @map("http_status")
  tempoRespostaMs Int?      @map("tempo_resposta_ms")
  createdAt       DateTime  @default(now()) @map("created_at")

  cliente      Cliente           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  controleSync NfseSyncControle? @relation(fields: [controleSyncId], references: [id], onDelete: SetNull)
  certificado  Certificado?      @relation(fields: [certificadoId], references: [id], onDelete: SetNull)

  @@map("nfse_sync_logs")
}

model NfeSyncControle {
  id                      String        @id @default(uuid()) @db.Uuid
  clienteId               String        @map("cliente_id") @db.Uuid
  estabelecimentoId       String        @map("estabelecimento_id") @db.Uuid
  cnpjConsulta            String        @map("cnpj_consulta") @db.VarChar(14)
  ambiente                NfeAmbiente
  ultimoNsuConsultado     BigInt        @default(0) @map("ultimo_nsu_consultado")
  ultimoNsuDistribuido    BigInt        @default(0) @map("ultimo_nsu_distribuido")
  maxNsu                  BigInt        @default(0) @map("max_nsu")
  status                  NfeSyncStatus @default(ativo)
  ultimaExecucao          DateTime?     @map("ultima_execucao")
  ultimaMensagem          String?       @map("ultima_mensagem") @db.Text
  totalDocumentosBaixados Int           @default(0) @map("total_documentos_baixados")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  cliente         Cliente                @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  estabelecimento ClienteEstabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)

  @@unique([clienteId, cnpjConsulta, ambiente], map: "nfe_sync_controle_cliente_id_cnpj_consulta_ambiente_key")
  @@map("nfe_sync_controle")
}

// NSU independente da distribuicao nacional de NF-e.
model NfceScSyncControle {
  id                             String                @id @default(uuid()) @db.Uuid
  clienteId                      String                @map("cliente_id") @db.Uuid
  estabelecimentoId              String                @map("estabelecimento_id") @db.Uuid
  cnpjConsulta                   String                @map("cnpj_consulta") @db.VarChar(14)
  certificadoId                  String?               @map("certificado_id") @db.Uuid
  ambiente                       NfeAmbiente
  indAtor                        Int                   @default(3) @map("ind_ator")
  ultimoNsuConsultado            BigInt                @default(0) @map("ultimo_nsu_consultado")
  status                         NfeSyncStatus         @default(ativo)
  ultimaExecucao                 DateTime?             @map("ultima_execucao")
  proximaExecucao                DateTime?             @map("proxima_execucao")
  ultimaMensagem                 String?               @map("ultima_mensagem") @db.Text
  totalDocumentosBaixados        Int                   @default(0) @map("total_documentos_baixados")
  diagnosticoXmlRequisicao       String?               @map("diagnostico_xml_requisicao") @db.Text
  diagnosticoXmlResposta         String?               @map("diagnostico_xml_resposta") @db.Text
  diagnosticoXmlCriadoEm         DateTime?             @map("diagnostico_xml_criado_em")
  reprocessamentoNsuInicial      BigInt?               @map("reprocessamento_nsu_inicial")
  reprocessamentoNsuFinal        BigInt?               @map("reprocessamento_nsu_final")
  reprocessamentoNsuAtual        BigInt?               @map("reprocessamento_nsu_atual")
  reprocessamentoStatus          NfceScRecoveryStatus? @map("reprocessamento_status")
  reprocessamentoTotalDocumentos Int                   @default(0) @map("reprocessamento_total_documentos")
  reprocessamentoMensagem        String?               @map("reprocessamento_mensagem") @db.Text
  reprocessamentoLease           DateTime?             @map("reprocessamento_lease")
  createdAt                      DateTime              @default(now()) @map("created_at")
  updatedAt                      DateTime              @updatedAt @map("updated_at")

  cliente         Cliente                @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  estabelecimento ClienteEstabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  certificado     Certificado?           @relation(fields: [certificadoId], references: [id], onDelete: SetNull)

  @@unique([clienteId, cnpjConsulta, ambiente], map: "nfce_sc_sync_controle_cliente_cnpj_ambiente_key")
  @@map("nfce_sc_sync_controle")
}

// Cursor independente da distribuicao nacional e da NFC-e SC.
model NfeScSyncControle {
  id                         String        @id @default(uuid()) @db.Uuid
  clienteId                  String        @map("cliente_id") @db.Uuid
  estabelecimentoId          String        @map("estabelecimento_id") @db.Uuid
  cnpjConsulta               String        @map("cnpj_consulta") @db.VarChar(14)
  certificadoId              String        @map("certificado_id") @db.Uuid
  ambiente                   NfeAmbiente
  indAtor                    Int           @default(3) @map("ind_ator")
  autorizacaoConfirmadaEm    DateTime      @map("autorizacao_confirmada_em")
  autorizacaoConfirmadaPorId String        @map("autorizacao_confirmada_por_id") @db.Uuid
  ultimoNsuConsultado        BigInt        @default(0) @map("ultimo_nsu_consultado")
  status                     NfeSyncStatus @default(ativo)
  ultimaExecucao             DateTime?     @map("ultima_execucao")
  proximaExecucao            DateTime?     @map("proxima_execucao")
  ultimaMensagem             String?       @map("ultima_mensagem") @db.Text
  totalDocumentosBaixados    Int           @default(0) @map("total_documentos_baixados")
  createdAt                  DateTime      @default(now()) @map("created_at")
  updatedAt                  DateTime      @updatedAt @map("updated_at")

  cliente                  Cliente                     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  estabelecimento          ClienteEstabelecimento      @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  certificado              Certificado                 @relation(fields: [certificadoId], references: [id], onDelete: Restrict)
  autorizacaoConfirmadaPor Usuario                     @relation("NfeScAutorizacaoConfirmadaPor", fields: [autorizacaoConfirmadaPorId], references: [id], onDelete: Restrict)
  documentosDistribuidos   NfeScDocumentoDistribuido[]

  @@unique([clienteId, cnpjConsulta, ambiente], map: "nfe_sc_sync_controle_cliente_cnpj_ambiente_key")
  @@map("nfe_sc_sync_controle")
}

// Guarda o NSU original da SEF/SC associado ao documento normalizado do NotaSync.
model NfeScDocumentoDistribuido {
  id             String   @id @default(uuid()) @db.Uuid
  controleId     String   @map("controle_id") @db.Uuid
  nfeDocumentoId String   @map("nfe_documento_id") @db.Uuid
  nsu            BigInt
  schemaDoc      String   @map("schema_doc") @db.VarChar(120)
  createdAt      DateTime @default(now()) @map("created_at")

  controle  NfeScSyncControle @relation(fields: [controleId], references: [id], onDelete: Cascade)
  documento NfeDocumento      @relation(fields: [nfeDocumentoId], references: [id], onDelete: Cascade)

  @@unique([controleId, nsu], map: "nfe_sc_documentos_distribuidos_controle_nsu_key")
  @@index([nfeDocumentoId], map: "nfe_sc_documentos_distribuidos_documento_idx")
  @@map("nfe_sc_documentos_distribuidos")
}

model NfeDocumento {
  id                      String              @id @default(uuid()) @db.Uuid
  clienteId               String              @map("cliente_id") @db.Uuid
  estabelecimentoId       String              @map("estabelecimento_id") @db.Uuid
  ambiente                NfeAmbiente
  nsu                     BigInt?

{
  "name": "nfse-collector",
  "version": "0.1.3",
  "private": true,
  "description": "Backend para coleta e consulta de NFS-e Nacional via ADN por NSU",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "pretest": "prisma generate",
    "test": "jest",
    "test:watch": "jest --watch",
    "pretest:e2e": "prisma generate",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prebuild": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "nfe:reset": "node scripts/reset-nfe-data.js",
    "nfe:reclassificar-ambiente": "node scripts/reclassify-nfe-environment.js",
    "nfe:separar-cte": "ts-node -r tsconfig-paths/register scripts/separate-cte-documents.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down -v",
    "release:manifest": "node scripts/generate-release-manifest.js",
    "sync:run-once": "node dist/jobs/run-sync-once.js",
    "job:verificar-certificados": "node dist/jobs/run-verificar-certificados-once.js",
    "job:gerar-danfse-pendente": "node dist/jobs/run-gerar-danfse-pendente-once.js",
    "job:reprocessar-erros": "node dist/jobs/run-reprocessar-erros-once.js",
    "job:limpar-temporarios": "node dist/jobs/run-limpar-temporarios-once.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.798.0",
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.20",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/swagger": "^7.4.2",
    "@nfewizard/danfe": "^1.0.3",
    "@prisma/client": "^5.20.0",
    "bullmq": "^5.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.6.1",
    "jszip": "^3.10.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.20",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.2",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
